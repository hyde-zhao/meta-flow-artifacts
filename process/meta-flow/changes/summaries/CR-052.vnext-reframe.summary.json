  "goal_statement": "把 Meta Flow 改造为每项目双库隔离、长期治理清晰、按风险选流程且读写检查受范围与 token 预算约束的 vNext",
  "scope_summary": [
    "每项目一个发布库和一个过程库；发布库优先复用现有项目源码/交付仓，不新增第三个仓库。",
    "过程库使用 Project/Roadmap/Phase/Work 四层治理，工作流使用 G0/G1/G2，所有读写检查由 Work scope 和 token budget 约束。",
    "旧共享过程仓只读保留；不重写历史、不做旧 CP/CR/Story 无损自动转换、不批量迁移其他项目。"
  ],
  "accepted_user_directions": [
    "简单、可靠、后续治理成本低",
    "优先消除跨项目分支切换导致的过程文档版本联动",
    "归档写入、文档读取、检查校验必须同时减负",
    "开始实施前创建整改前源码 tag"
  ],
  "recommended_defaults": {
    "release_repo": "reuse-existing-project-source-or-delivery-repository",
    "process_repo": "one-independent-main-only-repository-per-project",
    "process_writer": "single-publisher-with-expected-oid-cas",
    "migration": "snapshot-current-state-and-keep-old-shared-repo-read-only",
