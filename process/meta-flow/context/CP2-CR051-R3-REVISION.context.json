{
  "schema_version": 1,
  "stage": "CP2",
  "profile": "architecture-major",
  "project_id": "meta-flow",
  "cr_id": "CR-051",
  "state_ref": "process/state/STATE.current.json",
  "cr_index_ref": "process/changes/CR-INDEX.json",
  "cr_summary_ref": "process/changes/summaries/CR-051.summary.json",
  "read_policy_ref": "process/policies/READ-POLICY.json",
  "policy_refs": {
    "read_policy": "process/policies/READ-POLICY.json",
    "authz_policy": "process/policies/AUTHZ-POLICY.json",
    "gate_profiles": "process/policies/GATE-PROFILES.json",
    "artifact_budgets": "process/policies/ARTIFACT-BUDGETS.json"
  },
  "budget": {
    "max_tokens": 18000,
    "estimated_tokens": 3600,
    "estimator": "bounded-summary"
  },
  "must_read": [
    {"path": "process/state/STATE.current.json", "reason": "machine state and active CR", "required": true},
    {"path": "process/current/CURRENT.json", "reason": "current discovery entry", "required": true},
    {"path": "process/changes/summaries/CR-051.summary.json", "reason": "current R3 change summary", "required": true},
    {"path": "process/checks/CP2-CR051-R3-USER-DECISIONS.json", "reason": "authoritative user-confirmed R3 delta", "required": true},
    {"path": "process/handoffs/CR051-CP2-R3-META-PM.md", "reason": "write scope and exit criteria", "required": true}
  ],
  "allowed_reads": [
    {"path": "process/context/CP2-CR051-R3-REVISION.context.json", "reason": "capsule first", "required": true},
    {"path": "process/checkpoints/CP2-CR051-PROJECT-FIRST-WORKTREE-BASELINE-R2.md", "reason": "R2 historical baseline now changes_requested", "required": true},
    {"path": "process/checks/CP2-CR051-REQUIREMENTS-BASELINE-R2.result.json", "reason": "R2 machine result for supersession", "required": true},
    {"path": "process/docs/product/USE-CASES.md", "reason": "incremental R3 product update", "required": true},
    {"path": "process/docs/product/REQUIREMENTS.md", "reason": "incremental R3 product update", "required": true},
    {"path": "process/docs/product/SCENARIOS.yaml", "reason": "incremental R3 scenario update", "required": true},
    {"path": "process/docs/product/TEST-MATRIX.md", "reason": "incremental R3 trace update", "required": true},
    {"path": "process/docs/product/STORY-MAP.md", "reason": "incremental R3 journey update", "required": true},
    {"path": "process/docs/product/MVP-SCOPE.md", "reason": "incremental R3 scope update", "required": true},
    {"path": "process/docs/product/RELEASE-SLICES.md", "reason": "incremental R3 slice update", "required": true},
    {"path": "process/docs/product/BACKLOG.md", "reason": "incremental R3 deferred update", "required": true},
    {"path": "process/checks/CP2-CR051-DISCUSSION-CHECKPOINT.json", "reason": "update structured resolved decisions", "required": true}
  ],
  "read_if_needed": [
    {"path": "meta_flow/workflow/git_branch_lifecycle.py", "reason": "source fact check only; no source writes", "required": false}
  ],
  "denied_default_reads": [
    "process/STATE.md",
    "process/DEVELOPMENT-PLAN.yaml",
    "process/STORY-STATUS.md",
    "process/changes/*.md",
    "process/stories/*-LLD.md",
    "process/stories/*-IMPLEMENTATION.md",
    "process/archive/**",
    "process/discussions/**"
  ],
  "do_not_read_by_default": [
    {"path_or_pattern": "process/STATE.md", "reason": "generated human summary"},
    {"path_or_pattern": "process/archive/**", "reason": "historical cold evidence"},
    {"path_or_pattern": "process/stories/**", "reason": "CP2 not approved"},
    {"path_or_pattern": "../meta-flow-artifacts/process/quant-lab/**", "reason": "sibling project boundary"},
    {"path_or_pattern": "完整会话 transcript", "reason": "R3 decision delta is structured"}
  ],
  "full_doc_read_allowed_when": ["field_conflict", "human_audit", "deep_review", "schema_validation_failed"],
  "required_full_doc_read_log": "process/state/READ-EXPANSION-LEDGER.ndjson"
}
