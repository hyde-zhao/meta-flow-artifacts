    "commit_push_publish",
    "force_or_history_rewrite",
    "credentials_runtime_saas_production_write_trading",
    "process_quant_lab_changes"
  ],
  "risks": [
    "non-atomic switch can leave a third state and therefore fails closed",
    "remote bootstrap and manual sync races require exact OID and fresh postcheck",
    "evidence multi-writer or self-reference can break audit truth",
    "checkout write-byte estimator remains a CP5-calibrated non-blocking detail"
  ]
