  "scope_summary": {
    "architecture": "extend typed native-Git lifecycle with project context, recoverable worktree, heterogeneous legs, aggregate gate and read-only migration handoff",
    "switch_contract": "precheck -> external durable intent -> switch attempt -> fresh observation -> verified target/original or conditional rollback/recovery-required",
    "leg_contract": "source default and artifact project integration are heterogeneous targets; artifact CR never touches shared main",
    "aggregate_contract": "BLOCKED > FAIL > IN_PROGRESS > PASS; only all required legs PASS completes; PARTIAL is not terminal success",
    "sync_contract": "shared main and project integration synchronization is CR-external, manual and independently authorized"
  },
  "not_authorized": [
    "source_implementation_or_test_change",
    "real_artifact_file_migration",
    "symlink_mutation",
    "real_worktree_branch_ref_remote_mutation",
